## Connection string do PostgreSQL (Neon, Supabase, ou outro provedor).
## Copie este arquivo para .env e preencha com a sua string real.
DATABASE_URL=postgresql://usuario:senha@host/nome_do_banco?sslmode=require

## Segredo usado para assinar o cookie de sessão. Troque por um valor aleatório
## e mantenha em segredo (não commitar).
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

## Origem do frontend (usada no CORS para permitir envio de cookies).
WEB_ORIGIN=http://localhost:5173

PORT=4000
